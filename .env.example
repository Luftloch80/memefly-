# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.

# --- neuPrint (real fly connectome data) ---
# Get a free token at https://neuprint.janelia.org (sign in, click your
# account icon -> "Auth Token").
NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
# hemibrain has a well-documented antennal-lobe -> mushroom-body circuit
# (PN -> KC -> MBON) that this project uses as its "sensory -> decision"
# pathway. Swap in another dataset name if you want a different circuit.
NEUPRINT_DATASET=hemibrain:v1.2.1
NEUPRINT_INPUT_TYPE_REGEX=.*PN.*
NEUPRINT_OUTPUT_TYPE_REGEX=.*MBON.*
NEUPRINT_MAX_NEURONS=400

# --- Solana wallet ---
# Provide ONE of these, never both committed anywhere. Prefer a wallet
# that holds only the small amount of SOL you are prepared to lose.
SOLANA_PRIVATE_KEY=
SOLANA_KEYPAIR_PATH=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Target token / venue ---
# DISCOVERY_MODE=false (default): trade only TARGET_TOKEN_MINT below.
# DISCOVERY_MODE=true: ignore TARGET_TOKEN_MINT and let the bot pick which
# brand-new pump.fun coin to buy itself, using PumpPortal's live feed of
# newly created tokens plus the connectome signal. Materially riskier --
# most brand-new pump.fun tokens are rugs. See README before enabling.
DISCOVERY_MODE=false
TARGET_TOKEN_MINT=
PUMPPORTAL_POOL=pump
PUMPPORTAL_API_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_SLIPPAGE_PCT=10
PUMPPORTAL_PRIORITY_FEE_SOL=0.0005

# --- Discovery filters (only used when DISCOVERY_MODE=true) ---
DISCOVERY_WS_URL=wss://pumpportal.fun/api/data
# A coin must be at least this old before the bot will ever consider
# buying it -- filters out the very newest, highest-rug-risk launches.
DISCOVERY_MIN_AGE_SECONDS=300
# ...and no older than this, so it's only ever looking at fresh coins.
DISCOVERY_MAX_AGE_SECONDS=3600
# Minimum observed trades before the bot considers a coin -- some
# evidence of organic activity, not just the creation transaction.
DISCOVERY_MIN_TRADES=20
DISCOVERY_MAX_CANDIDATES=30

# --- Risk limits (all in SOL) ---
MAX_TRADE_SOL=0.05
MAX_POSITION_SOL=0.2
MAX_DAILY_LOSS_SOL=0.3
COOLDOWN_SECONDS=300
STOP_LOSS_PCT=0.25
TAKE_PROFIT_PCT=0.5

# --- Signal thresholds ---
BUY_THRESHOLD=0.2
SELL_THRESHOLD=-0.2

# --- Safety switches: BOTH must be set for live orders to be sent. ---
LIVE_TRADING=false
I_UNDERSTAND_THE_RISK=no

LOOP_INTERVAL_SECONDS=60
